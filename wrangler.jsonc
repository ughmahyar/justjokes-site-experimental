// Cloudflare deploy settings for the live site (justjokesmy.com).
// Deploy: npx wrangler@4 deploy   (run from this folder)
{
  "name": "justjokes-preview",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/video/*"]
  }
}
